---
import Header from '@/site/Header.astro'

import BaseLayout from './BaseLayout.astro'

// A page of the app: what it shows until the app is there, the app does the rest. Only /login
// is for search engines.
interface Props {
  title?: string
  description?: string
  path?: string
}

const { title = 'Pokemon TCG Pocket Exchange Center - Trade Your Cards with the World', ...page } =
  Astro.props
---

<BaseLayout title={title} {...page}>
  <div id="app">
    <Header />
    <slot />
  </div>
  <script>
    import '@/main'
  </script>
</BaseLayout>
