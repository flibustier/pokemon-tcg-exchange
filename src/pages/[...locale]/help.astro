---
import SiteLayout from '@/layouts/SiteLayout.astro'
import { rarities } from '@/services/cards'
import { localePath, type Locale } from '@/services/texts'
import Rarity from '@/site/Rarity.astro'
import Rich from '@/site/Rich.astro'
import { localizedPaths, useTexts } from '@/site/texts'

export const getStaticPaths = localizedPaths

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { site, app } = useTexts(locale)
const { rules, steps, packs, faq, contact, ...help } = site.help

const links = { site: localePath(locale, '/'), mail: 'mailto:help@pokemon-tcg.exchange' }
const number = new Intl.NumberFormat(locale)

// ☆☆ cards have two rarities in the database, at the same price
const costs = (Object.keys(rarities) as (keyof typeof rarities)[])
  .filter((rarity) => 'count' in rarities[rarity] && rarity !== 'SAR')
  .map((rarity) => ({ rarity, ...rarities[rarity] }))
  .sort((a, b) => Number(b.tradeable) - Number(a.tradeable))
---

<SiteLayout title={help.title} description={help.description} path="/help" locale={locale}>
  <article class="help-page">
    <h1>{help.heading}</h1>
    <p class="intro">
      <Rich text={help.intro} links={links} />
    </p>

    <section>
      <h2>{rules.heading}</h2>
      <ul>
        {rules.items.map((item) => (
          <li>
            <Rich text={item} />
          </li>
        ))}
      </ul>
      <h3 id="costs">{rules.costs}</h3>
      <table>
        <thead>
          <tr>
            <th scope="col" colspan="2">
              {rules.rarity}
            </th>
            <th scope="col">{rules.cost}</th>
          </tr>
        </thead>
        <tbody>
          {costs.map(({ rarity, tradeable, tradePrice }) => (
            <tr>
              <td class="symbols">
                <Rarity rarity={rarity} />
              </td>
              <td>{app(`rarity.${rarity}`)}</td>
              <td class="cost">
                {tradeable
                  ? tradePrice
                    ? number.format(tradePrice)
                    : rules.free
                  : rules.notTradeable}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <section>
      <h2>{help.site.heading}</h2>
      <p>
        <Rich text={help.site.intro} links={links} />
      </p>
      <ul>
        {help.site.items.map((item) => (
          <li>
            <Rich text={item} />
          </li>
        ))}
      </ul>
      <p>{help.site.outro}</p>
      <p>
        <a class="cta" href={localePath(locale, '/')}>
          {help.cta}
        </a>
      </p>
    </section>

    <section>
      <h2>{steps.heading}</h2>
      <ol>
        <li>
          <h3>{steps.wants.title}</h3>
          <p>
            <Rich text={steps.wants.text} />
          </p>
          <img
            src="/images/screenshots/home-step-1.webp"
            loading="lazy"
            decoding="async"
            width="770"
            height="606"
            alt={steps.wants.alt}
          />
        </li>
        <li>
          <h3>{steps.offers.title}</h3>
          <p>
            <Rich text={steps.offers.text} />
          </p>
          <img
            src="/images/screenshots/home-step-2.webp"
            loading="lazy"
            decoding="async"
            width="770"
            height="595"
            alt={steps.offers.alt}
          />
        </li>
        <li>
          <h3>{steps.friendId.title}</h3>
          <p>{steps.friendId.text}</p>
          <ul>
            {steps.friendId.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <img
            class="phone"
            src="/images/screenshots/friend-id.webp"
            loading="lazy"
            decoding="async"
            width="280"
            height="400"
            alt={steps.friendId.alt}
          />
        </li>
        <li>
          <h3>{steps.matches.title}</h3>
          <p>{steps.matches.text}</p>
          <ul>
            {steps.matches.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <img
            src="/images/screenshots/proposals-1.webp"
            loading="lazy"
            decoding="async"
            width="770"
            height="660"
            alt={steps.matches.alt}
          />
        </li>
        <li>
          <h3>{steps.account.title}</h3>
          <p>{steps.account.text}</p>
          <img
            src="/images/screenshots/settings-1.webp"
            loading="lazy"
            decoding="async"
            width="770"
            height="553"
            alt={steps.account.alt}
          />
        </li>
      </ol>
    </section>

    <section>
      <h2>{packs.heading}</h2>
      <div class="row">
        <div>
          <p>{packs.text}</p>
          <ul>
            {packs.items.map((item) => (
              <li>
                <Rich text={item} />
              </li>
            ))}
          </ul>
        </div>
        <img
          class="phone"
          src="/images/screenshots/packs.webp"
          loading="lazy"
          decoding="async"
          width="314"
          height="517"
          alt={packs.alt}
        />
      </div>
    </section>

    <section>
      <h2>{faq.heading}</h2>
      {faq.list.map(({ question, answer }) => (
        <details>
          <summary>
            <h3>{question}</h3>
          </summary>
          <p>{answer}</p>
        </details>
      ))}
    </section>

    <section>
      <h2>{contact.heading}</h2>
      <p>
        <Rich text={contact.text} links={links} />
      </p>
    </section>
  </article>
</SiteLayout>

<style>
  .help-page {
    max-width: 900px;
    margin: 1rem auto;
    padding: 2rem;
    background: var(--color-surface);
    border-radius: 16px;
    box-shadow:
      0 4px 24px rgba(0, 0, 0, 0.07),
      0 0 0 1px var(--ring-color);
    color: var(--color-text);
  }

  h1 {
    font-size: 2.1rem;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  .intro {
    font-size: 1.15rem;
    color: var(--color-text-muted);
  }

  h2 {
    margin: 2.5rem 0 0.75rem;
    font-size: 1.5rem;
    line-height: 1.3;
    color: var(--color-teal);
  }

  h3 {
    font-size: 1.1rem;
    font-weight: bold;
  }

  #costs {
    margin: 1.5rem 0 0.5rem;
  }

  ul,
  ol {
    margin: 0.75rem 0 0.75rem 1.5rem;
  }

  ol > li {
    margin-bottom: 1.5rem;
  }

  :global(.help-page strong),
  :global(.help-page b) {
    font-weight: bold;
  }

  table {
    width: 100%;
    max-width: 520px;
    border-collapse: collapse;
  }

  th,
  td {
    padding: 0.4rem 0.5rem;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
  }

  th {
    font-weight: bold;
  }

  .symbols {
    white-space: nowrap;
  }

  .symbols :global(img) {
    margin-right: 2px;
    vertical-align: middle;
  }

  .cost,
  th:last-child {
    text-align: right;
  }

  img:not(.symbols img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1rem 0;
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  img.phone {
    margin: 1rem auto;
  }

  .row {
    display: flex;
    gap: 2rem;
  }

  details {
    margin: 0.75rem 0;
    padding: 0.7rem 1rem;
    background: var(--color-surface-soft);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  details[open] {
    background: var(--color-teal-soft);
  }

  summary {
    cursor: pointer;
  }

  summary h3 {
    display: inline;
  }

  details p {
    margin-top: 0.5rem;
  }

  :global(.help-page a) {
    color: var(--text-primary);
  }

  .cta {
    display: inline-block;
    margin-top: 1rem;
    padding: 10px 30px;
    border-radius: 25px;
    box-shadow: 0 0 0 2px var(--accent);
    text-decoration: none;
  }

  @media (max-width: 600px) {
    .help-page {
      padding: 1rem 0.5rem;
      box-shadow: none;
    }

    .row {
      flex-direction: column;
    }
  }
</style>
