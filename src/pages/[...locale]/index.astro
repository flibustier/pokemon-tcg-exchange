---
import CardIcon from '@/components/icons/CardIcon.vue'
import ExchangeIcon from '@/components/icons/ExchangeIcon.vue'
import HeartIcon from '@/components/icons/HeartIcon.vue'
import SiteLayout from '@/layouts/SiteLayout.astro'
import { cards } from '@/services/cards'
import { formatText, localePath, type Locale } from '@/services/texts'
import { nameOf, setPath, sets, type SiteSet } from '@/site/sets'
import { localizedPaths, useTexts } from '@/site/texts'

export const getStaticPaths = localizedPaths

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { home, help } = useTexts(locale).site
const helpPath = localePath(locale, '/help')

const number = new Intl.NumberFormat(locale)
const facts = [
  formatText(locale, home.facts.cards, { count: number.format(cards.length) }),
  formatText(locale, home.facts.sets, { count: number.format(sets.length) }),
  home.facts.free,
]

// The pages of the sets are in English only, for now
const setLink = (set: SiteSet) => (locale === 'en' ? setPath(set) : `/start#${set.code}`)

const STEP_ICONS = [HeartIcon, CardIcon, ExchangeIcon]

// A fan of the art cards of the latest sets
const fan = sets
  .flatMap((set) => set.cards.filter(({ rarity }) => rarity === 'AR').slice(0, 2))
  .slice(0, 5)

const questions = help.faq.list.slice(0, 4)
---

<SiteLayout title={home.title} description={home.description} path="/" locale={locale}>
  <Fragment slot="head">
    <script is:inline>
      // A signed-in player goes on with their proposals, before the first paint
      try {
        if (localStorage.getItem('token') !== null) location.replace('/account/proposals')
      } catch (e) {}
    </script>
  </Fragment>

  <section class="hero">
    <div>
      <h1>{home.heading}</h1>
      <p class="intro">{home.intro}</p>
      <p class="ctas">
        <a class="cta" href="/start">
          {home.cta}
        </a>
        <a class="sign-in-link" href="/login">
          {home.signIn}
        </a>
      </p>
      <ul class="facts">
        {facts.map((fact) => (
          <li>{fact}</li>
        ))}
      </ul>
    </div>
    <div class="fan" aria-hidden="true">
      {fan.map((card) => (
        <img
          src={card.imagePaths.thumbnail}
          alt=""
          width="200"
          height="280"
          decoding="async"
          fetchpriority="low"
        />
      ))}
    </div>
  </section>

  <section>
    <h2>{home.steps.heading}</h2>
    <ol class="steps">
      {home.steps.list.map(({ title, text }, index) => {
        const Icon = STEP_ICONS[index]
        return (
          <li>
            <span class="step-icon">
              <Icon />
            </span>
            <h3>
              {index + 1}. {title}
            </h3>
            <p>{text}</p>
          </li>
        )
      })}
    </ol>
    <p class="after-steps">
      <a class="cta" href="/start">
        {home.cta}
      </a>
    </p>
  </section>

  <section>
    <h2>{home.features.heading}</h2>
    <ul class="features">
      {home.features.list.map(({ title, text }) => (
        <li>
          <h3>{title}</h3>
          <p>{text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>{home.sets.heading}</h2>
    <p>{home.sets.text}</p>
    <ul class="sets">
      {sets.map((set) => (
        <li>
          <a href={setLink(set)} title={nameOf(set, locale)}>
            <img
              src={set.imagePath}
              alt={nameOf(set, locale)}
              width="192"
              height="85"
              loading="lazy"
              decoding="async"
            />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="faq">
    <h2>{home.faq.heading}</h2>
    {questions.map(({ question, answer }) => (
      <details>
        <summary>
          <h3>{question}</h3>
        </summary>
        <p>{answer}</p>
      </details>
    ))}
    <p>
      <a href={helpPath}>{home.faq.more}</a>
    </p>
  </section>

  <section class="final">
    <h2>{home.final.heading}</h2>
    <p>
      <a class="cta" href="/start">
        {home.cta}
      </a>
    </p>
  </section>
</SiteLayout>

<style>
  section {
    margin: 0 auto 4rem;
    max-width: 1100px;
  }

  h1 {
    font-size: 2.6rem;
    line-height: 1.15;
  }

  h2 {
    margin-bottom: 1rem;
    font-size: 1.7rem;
    line-height: 1.3;
    color: var(--color-teal);
  }

  h3 {
    font-size: 1.1rem;
    font-weight: bold;
  }

  a {
    color: var(--text-primary);
  }

  .hero {
    display: flex;
    align-items: center;
    gap: 3rem;
    margin-top: 2rem;
  }

  .hero > div:first-child {
    flex: 1;
  }

  .intro {
    margin: 1rem 0 1.5rem;
    font-size: 1.2rem;
    color: var(--color-text-muted);
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .cta {
    display: inline-block;
    padding: 14px 36px;
    border-radius: 30px;
    background: var(--accent);
    color: #0b2a4a;
    font-size: 1.15rem;
    font-weight: bold;
    text-decoration: none;
    box-shadow: 0 4px 14px var(--accent-shadow-strong);
  }

  .cta:hover {
    background: var(--accent-hover);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-top: 1.5rem;
    padding: 0;
    list-style: none;
    color: var(--color-text-muted);
  }

  .facts li::before {
    content: '✓ ';
    color: var(--color-teal);
  }

  .fan {
    display: flex;
    justify-content: center;
    width: 420px;
    padding: 1rem 0;
  }

  .fan img {
    width: 150px;
    height: auto;
    margin: 0 -42px;
    border-radius: 8px;
    background: var(--color-surface-mute);
    box-shadow: 0 4px 16px var(--shadow-tinted-strong);
    position: relative;
  }

  .fan img:nth-child(1) {
    transform: rotate(-14deg) translateY(24px);
  }

  .fan img:nth-child(2) {
    transform: rotate(-7deg) translateY(6px);
  }

  .fan img:nth-child(3) {
    z-index: 2;
  }

  .fan img:nth-child(2),
  .fan img:nth-child(4) {
    z-index: 1;
  }

  .fan img:nth-child(4) {
    transform: rotate(7deg) translateY(6px);
  }

  .fan img:nth-child(5) {
    transform: rotate(14deg) translateY(24px);
  }

  .steps,
  .features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    padding: 0;
    list-style: none;
  }

  .steps li,
  .features li {
    padding: 1.25rem;
    border-radius: 16px;
    background: var(--color-surface-soft);
    box-shadow: 0 0 0 1px var(--ring-color);
  }

  .after-steps {
    margin-top: 2rem;
    text-align: center;
  }

  .step-icon {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 2rem;
    line-height: 1;
    color: var(--color-teal);
  }

  .sets {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
    padding: 0;
    list-style: none;
  }

  .sets a {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 90px;
    padding: 0.75rem;
    border-radius: 12px;
    background: var(--color-surface-soft);
    box-shadow: 0 0 0 1px var(--ring-color);
  }

  .sets a:hover {
    background: var(--color-surface-hover);
    box-shadow: 0 0 0 2px var(--accent);
  }

  .sets img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
  }

  .faq {
    max-width: 800px;
  }

  details {
    margin: 0.75rem 0;
    padding: 0.7rem 1rem;
    background: var(--color-surface-soft);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  details[open] {
    background: var(--color-teal-soft);
  }

  summary {
    cursor: pointer;
  }

  summary h3 {
    display: inline;
  }

  details p {
    margin-top: 0.5rem;
  }

  .final {
    text-align: center;
  }

  @media (max-width: 900px) {
    h1 {
      font-size: 2rem;
    }

    .hero {
      flex-direction: column;
      gap: 1rem;
      margin-top: 1rem;
      margin-bottom: 2.5rem;
    }

    .fan {
      width: 100%;
      max-width: 360px;
    }

    .fan img {
      width: 110px;
      margin: 0 -28px;
    }

    .steps,
    .features {
      grid-template-columns: 1fr;
    }

    section {
      margin-bottom: 3rem;
    }
  }
</style>
